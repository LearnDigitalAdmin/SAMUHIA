+/* Privacy Policy and Terms of Use: summary box, contents list, readable tables. */
+/* ===== LEGAL ===== */
+.lg {
+  max-width:860px;
+}
+.lg header .lead {
+  max-width:68ch;
+}
+.lg-meta {
+  margin-top:14px;
+  font-size:.88rem;
+}
+.lg-short {
+  margin-top:32px;
+  padding:clamp(18px,3vw,28px);
+  border:1px solid var(--color-border);
+  border-left:4px solid var(--color-primary);
+  border-radius:var(--r);
+  background:var(--color-surface);
+}
+.lg-short h2 {
+  margin:0 0 12px!important;
+  font-size:1.25rem!important;
+}
+.lg-short ul {
+  padding-left:1.1em;
+  display:grid;
+  gap:8px;
+}
+.lg-toc {
+  margin-top:28px;
+}
+.lg-toc ol {
+  columns:2 260px;
+  gap:28px;
+  padding-left:1.4em;
+  font-size:.95rem;
+}
+.lg-toc li {
+  margin:4px 0;
+}
+.lg section h2 {
+  margin:48px 0 14px;
+  font-size:clamp(1.3rem,2.4vw,1.7rem);
+}
+.lg section p,
+.lg section ul,
+.lg section ol {
+  max-width:72ch;
+  margin-top:12px;
+}
+.lg section ul,
+.lg section ol {
+  padding-left:1.3em;
+}
+.lg section li {
+  margin:6px 0;
+}
+.lg-tw {
+  margin-top:16px;
+  overflow-x:auto;
+  border:1px solid var(--color-border);
+  border-radius:var(--r);
+}
+.lg-tw table {
+  width:100%;
+  min-width:560px;
+  border-collapse:collapse;
+  font-size:.92rem;
+}
+.lg-tw th,
+.lg-tw td {
+  text-align:left;
+  vertical-align:top;
+  padding:12px 14px;
+  border-bottom:1px solid var(--color-border);
+}
+.lg-tw th {
+  background:var(--color-surface);
+  font-weight:700;
+}
+.lg-tw tr:last-child td {
+  border-bottom:0;
+}
+.lg-note {
+  margin-top:16px;
+  padding:16px 18px;
+  border-radius:var(--r);
