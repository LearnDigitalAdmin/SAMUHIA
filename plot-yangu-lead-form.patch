+/* Plot Yangu lead page: hero band, embedded Google Form frame, contact band. */
+/* ===== LEADS ===== */
+.ld-hero {
+  position:relative;
+  overflow:hidden;
+  background:var(--dark);
+  color:#EDEAE3;
+  border-radius:12px;
+  padding:clamp(28px,5vw,64px);
+  background-image:radial-gradient(120% 90% at 100% 0,color-mix(in srgb,var(--c,#7A3E8E) 45%,transparent),transparent 60%);
+}
+.ld-hero .eyebrow {
+  color:#7FD1B9;
+  margin-top:16px;
+}
+.ld-hero h1 {
+  font-size:clamp(2.1rem,5vw,3.6rem);
+  max-width:20ch;
+}
+.ld-hero .lead {
+  color:#B7C0BB;
+  max-width:62ch;
+  margin-top:18px;
+}
+.ld-hero .row {
+  margin-top:26px;
+}
+.ld-hero .btn {
+  border-color:rgba(255,255,255,.3);
+}
+.ld-hero .btn:hover {
+  border-color:#fff;
+}
+.ld-hero .btn.pri {
+  background:#F1EDE4;
+  border-color:#F1EDE4;
+  color:#0B1210;
+}
+.ld-pts {
+  list-style:none;
+  padding:0;
+  display:flex;
+  flex-wrap:wrap;
+  gap:8px;
+  margin:22px 0 4px;
+}
+.ld-pts li {
+  font-size:.82rem;
+  font-weight:600;
+  padding:6px 14px;
+  border:1px solid rgba(255,255,255,.18);
+  border-radius:99px;
+  color:#DCE3DF;
+}
+.ld-pts li:before {
+  content:"✓ ";
+  color:#7FD1B9;
+}
+.page h2[id] {
+  scroll-margin-top:84px;
+}
+.ld-who {
+  margin:28px 0 8px;
+}
+.ld-who h3 {
+  font-size:1.05rem;
+  margin-bottom:12px;
+}
+.ld-fallback {
+  margin:20px 0 14px;
+  font-size:.92rem;
+}
+.ld-frame {
+  max-width:760px;
+  border:1px solid var(--color-border);
+  border-radius:var(--r);
+  background:var(--color-surface);
+  overflow:hidden;
+}
+.ld-frame iframe {
+  display:block;
+  width:100%;
+  height:var(--ld-h,1583px);
+  border:0;
+}
+.ld-consent {
+  font-size:.85rem;
+  margin-top:14px;
+  max-width:68ch;
+}
+.ld-talk {
+  display:flex;
+  flex-wrap:wrap;
+  align-items:center;
+  justify-content:space-between;
+  gap:20px;
+  margin-top:72px;
+  padding:clamp(22px,4vw,36px);
+  border-radius:var(--r);
+  background:var(--dark);
+  color:#fff;
+}
+.ld-talk h2 {
+  margin:0!important;
+}
+.ld-talk p {
+  color:#B7C0BB;
+  max-width:58ch;
+  margin-top:6px;
+}
+.ld-talk .ld-num a {
+  color:#fff;
+  font-weight:600;
+}
+.ld-talk .btn.pri {
+  background:#F1EDE4;
+  border-color:#F1EDE4;
+  color:#0B1210;
+}
+@media(max-width:700px){
+  .ld-frame iframe {
+    height:var(--ld-h-m,2000px);
+  }
+}
