+}
+.cr-sl button[hidden] {
+  display:none;
+}
+.product-careers {
+  display:flex;
+  flex-wrap:wrap;
+  align-items:center;
+  justify-content:space-between;
+  gap:20px;
+  padding:clamp(22px,4vw,36px);
