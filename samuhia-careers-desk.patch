+{
+  "order": 3,
+  "slug": "desk",
+  "name": "Samuhia Desk",
+  "category": "Agent Desks & Customer Support",
+  "audience": "Approved desk agents, and the chamas, schools and landlords they support",
+  "status": "Operational",
+  "appUrl": "https://cyber.cogvana.co.ke",
+  "color": "#2F4A8A",
+  "abbr": "SD",
+  "description": "A secure workspace where approved agents set up, support and collect for chamas, schools and landlords, and are paid automatically.",
+  "longDescription": "Samuhia Desk is the workspace for approved Samuhia agents. With a customer's one-time code, an agent opens their MyChama, MyRegister or Plot Yangu account, imports or enters records, schedules SMS, runs reports and collects rent. Customers pay fixed prices by M-Pesa, and Paystack splits each payment so the agent's share reaches their payout account automatically.",
+  "problem": "Many chamas, schools and landlords want to go digital but lack the time or skills to load records, set up reminders and run reports. Local people they trust could help, but there has been no safe, paid way to do it.",
+  "features": [
+    "One-time-code access to a customer's account, only with their permission",
+    "Excel import of members, students or tenants for a flat KES 200",
+    "Manual entry for paper records, priced by number of records",
+    "Schedule setup and bulk SMS reminders for KES 100",
+    "Reports and data exports run for the customers you support",
+    "Rent collection by M-Pesa prompt for Plot Yangu tenants",
+    "Support visits logged and confirmed by the customer with a code",
+    "Requests inbox: help requests from MyChama, MyRegister and Plot Yangu reach the right desk",
+    "Earnings dashboard with commissions, service income, payables and refund reversals",
+    "Automatic Paystack split at the moment the customer pays",
+    "Application, document upload, training and activation inside the app"
+  ],
+  "steps": [
+    "An agent applies, uploads ID documents and sets a payout account.",
+    "Samuhia reviews, trains and activates the desk.",
+    "A customer asks for help and reads the agent a one-time code.",
+    "The agent completes the job in the app and the customer pays the fixed price by M-Pesa.",
+    "Paystack splits the payment and the agent's share is paid automatically. Earnings update in the dashboard."
+  ],
+  "facts": [
+    { "label": "Works on", "value": "Web dashboard" },
+    { "label": "Access", "value": "Approved agents only, one-time customer codes" },
+    { "label": "Payments", "value": "M-Pesa through Paystack" },
+    { "label": "Service prices", "value": "Fixed, from KES 100" }
+  ],
+  "plans": [],
+  "priceNote": "Desk agents keep 97.5% of every desk service after payment fees. Commission rates for subscriptions and SMS depend on rank and product.",
+  "priceSummary": "Customers pay fixed service prices from KES 100. Agents keep 97.5% after payment fees and earn commission on subscriptions and SMS. See the careers page for estimates.",
+  "ctaLabel": "Open Samuhia Desk",
+  "ctaSecondary": "Explore Samuhia Desk",
+  "connects": "Desk works across MyChama, MyRegister and Plot Yangu, and every charge runs through Samuhia Payments.",
+  "careersCta": {
+    "title": "Earn as a Samuhia Desk agent",
+    "text": "Choose a Clerk, Senior, Chama, School or Property path. See real KES estimates for every plan and service before you apply.",
+    "label": "View desk careers",
+    "href": "/careers/"
+  },
+  "related": ["mychama", "myregister", "plot-yangu", "payments"],
+  "solution": "digital-services",
+  "faq": [
+    {
+      "q": "Is Samuhia Desk an official government service?",
+      "a": "No. It is a Samuhia workspace for approved agents who help customers with digital workflows. It is not a government platform."
+    },
+    {
+      "q": "How can an agent open a customer's account?",
+      "a": "Only with the customer's permission. The customer receives a one-time code by SMS and reads it to the agent, who enters it in the app."
+    },
+    {
+      "q": "How are agents paid?",
+      "a": "Each customer payment is split by Paystack after its fees, and the agent's share is sent to the agent's payout account. Refunds are handled by Paystack and appear as reversals in the agent's earnings."
+    },
+    {
+      "q": "Can I become a desk agent?",
+      "a": "Yes. Apply in the app, upload your documents and complete Samuhia's training. Desk agents are independent and commission-based, with no salary or guaranteed income."
+    }
+  ],
+  "presentation": {
+    "ecoX": 80,
+    "ecoY": 20,
+    "ecoColor": "#7C9BE8",
+    "chartBars": [60, 35, 75, 50, 68, 45],
+    "mockNav": ["Access", "Import", "Messages", "Reports", "Rent", "Earnings"],
+    "mockKpis": [
+      { "label": "Customers", "value": "12" },
+      { "label": "Paid", "value": "9" },
+      { "label": "Pending", "value": "3" }
+    ],
+    "mockRows": [
+      { "a": "Excel import", "b": "Chama", "status": "Paid" },
+      { "a": "Schedule setup", "b": "School", "status": "Paid" },
+      { "a": "Manual entry", "b": "Landlord", "status": "Pending" }
+    ]
+  },
+  "schemaCategory": "BusinessApplication",
+  "operatingSystem": "Web"
