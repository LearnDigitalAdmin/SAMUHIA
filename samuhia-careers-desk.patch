+/* Careers: hero band, stats, path cards, earnings tables (cards on mobile), scenarios, journey, share bar. */
+/* ===== CAREERS ===== */
+.cr-hero {
+  position:relative;
+  overflow:hidden;
+  background:var(--dark);
+  color:#EDEAE3;
+  border-radius:12px;
+  padding:clamp(28px,5vw,64px);
+  background-image:radial-gradient(120% 90% at 100% 0,color-mix(in srgb,var(--c,#2BA383) 38%,transparent),transparent 60%);
+}
+.cr-hero .eyebrow {
+  color:#7FD1B9;
+}
+.cr-hero h1 {
+  font-size:clamp(2.2rem,5.4vw,4rem);
+  max-width:18ch;
+}
+.cr-hero .lead {
+  color:#B7C0BB;
+  max-width:62ch;
+  margin-top:18px;
+}
+.cr-pts {
+  list-style:none;
+  padding:0;
+  display:flex;
+  flex-wrap:wrap;
+  gap:8px;
+  margin:22px 0 4px;
+}
+.cr-pts li {
+  font-size:.82rem;
+  font-weight:600;
+  padding:6px 14px;
+  border:1px solid rgba(255,255,255,.18);
+  border-radius:99px;
+  color:#DCE3DF;
+}
+.cr-pts li:before {
+  content:"✓ ";
+  color:#7FD1B9;
+}
+.cr-hero .row {
+  margin-top:26px;
+}
+.cr-note {
+  font-size:.82rem;
+  margin-top:14px;
+}
+.cr-hero .cr-note {
+  color:#8E9A95;
+}
+.cr-stats {
+  display:grid;
+  grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));
+  gap:1px;
+  background:var(--color-border);
+  border:1px solid var(--color-border);
+  border-radius:var(--r);
+  overflow:hidden;
+  margin-top:20px;
+}
+.cr-stats div {
+  background:var(--color-surface);
+  padding:20px 22px;
+  display:flex;
+  flex-direction:column-reverse;
+  justify-content:flex-end;
+  gap:6px;
+}
+.cr-stats dd {
+  margin:0;
+  font-size:clamp(1.5rem,2.6vw,2rem);
+  font-weight:650;
+  letter-spacing:-.03em;
+  line-height:1.1;
+  color:var(--color-primary);
+}
+.cr-stats dt {
+  font-size:.82rem;
+  color:var(--color-muted);
+  line-height:1.4;
+}
+.cr-jump {
+  display:flex;
+  gap:8px;
+  overflow-x:auto;
+  padding:18px 0 2px;
+  scrollbar-width:thin;
+}
+.cr-jump a {
+  flex:none;
+  font-size:.85rem;
+  font-weight:600;
+  text-decoration:none;
+  color:var(--color-text);
+  padding:7px 15px;
+  border:1px solid var(--color-border);
+  border-radius:99px;
+  background:var(--color-surface);
+}
+.cr-jump a:hover {
+  border-color:var(--color-primary);
+  color:var(--color-primary);
+}
+.page section[aria-labelledby] {
+  scroll-margin-top:84px;
+}
+.page .lead {
+  max-width:68ch;
+}
+.cr-h3 {
+  margin:36px 0 14px;
+  font-size:1.05rem;
+}
+.cr-paths {
+  display:grid;
+  gap:14px;
+  grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));
+  margin-top:26px;
+}
+.cr-path {
+  position:relative;
+  display:flex;
+  flex-direction:column;
+  gap:8px;
+  padding:20px;
+  background:var(--color-surface);
+  border:1px solid var(--color-border);
+  border-top:3px solid var(--c);
+  border-radius:var(--r);
+  text-decoration:none;
+  color:inherit;
+  transition:transform .2s,box-shadow .2s;
+}
+.cr-path:hover {
+  transform:translateY(-3px);
+  box-shadow:0 16px 36px rgba(12,19,17,.09);
+}
+.cr-path.cur {
+  box-shadow:inset 0 0 0 1px var(--c);
+}
+.cr-path strong {
+  font-size:1.15rem;
+  letter-spacing:-.02em;
+}
+.cr-path > span:not(.cr-k):not(.cr-ic) {
