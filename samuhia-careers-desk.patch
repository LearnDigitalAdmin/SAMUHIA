+  letter-spacing:-.03em;
+  color:var(--color-primary);
+}
+.cr-j {
+  list-style:none;
+  padding:0;
+  display:grid;
+  gap:14px;
+  grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));
+  margin-bottom:26px;
+}
+.cr-j li {
+  display:flex;
+  gap:14px;
+  padding:18px;
+  background:var(--color-surface);
+  border:1px solid var(--color-border);
+  border-radius:var(--r);
+}
+.cr-j .n {
+  flex:none;
+  width:32px;
+  height:32px;
+  border-radius:50%;
