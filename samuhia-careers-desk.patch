+  border:0;
+  padding:6px 0;
+  background:none;
+}
+.cr-tot {
+  display:flex;
+  justify-content:space-between;
+  align-items:baseline;
+  margin-top:auto;
+  padding-top:14px;
+  border-top:2px solid var(--color-text);
+}
+.cr-tot strong {
