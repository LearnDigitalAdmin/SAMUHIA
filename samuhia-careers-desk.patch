+}
+.cr-t tbody tr:last-child > * {
+  border-bottom:0;
+}
+.cr-t tbody th {
+  font-weight:500;
+}
+.cr-t small {
+  display:block;
+  margin-top:3px;
+  color:var(--color-muted);
+  font-size:.82rem;
+  line-height:1.45;
+}
+.cr-t td.hl {
+  background:color-mix(in srgb,var(--color-primary) 8%,transparent);
+  color:var(--color-primary);
+}
+.cr-st {
+  display:inline-block;
+  font-size:.7rem;
+  font-weight:700;
+  padding:3px 10px;
+  border-radius:99px;
+  white-space:nowrap;
+}
+.cr-st.live {
+  background:#E4F2EA;
+  color:var(--color-success);
+}
+.cr-st.soon {
+  background:#FBF0DA;
+  color:#8A5A0B;
+}
+.cr-st.disc {
+  background:#ECE9E1;
+  color:var(--color-muted);
+}
+.cr-call {
+  padding:16px 20px;
+  border-left:3px solid var(--color-secondary);
+  background:color-mix(in srgb,var(--color-secondary) 10%,var(--color-surface));
+  border-radius:0 var(--r) var(--r) 0;
+  margin-bottom:22px;
+  font-weight:500;
+}
+.cr-sc {
+  display:grid;
+  gap:16px;
+  grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));
+}
+.cr-card {
+  background:var(--color-surface);
+  border:1px solid var(--color-border);
